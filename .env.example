# Required: Telegram bot token from @BotFather
TELEGRAM_TOKEN=replace-with-your-telegram-bot-token

# Required for Ethereum balance lookups (Etherscan API V2)
ETHERSCAN_API_KEY=replace-with-your-etherscan-api-key

# Optional: custom Solana JSON-RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: direct admin chat. This ID also authorizes /stats and /broadcast.
ADMIN_CHAT_ID=

# Optional: separate chat or channel for operational logs
LOG_CHANNEL_ID=
